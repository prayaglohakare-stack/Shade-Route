{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shaderoute:schema:campus-registry:1",
  "title": "ShadeRoute campus registry",
  "type": "object",
  "required": ["schemaVersion", "campuses"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "campuses": {
      "type": "array",
      "items": { "$ref": "#/$defs/campus" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "campus": {
      "type": "object",
      "required": ["campusId", "name", "address", "timezone", "dataStatus"],
      "properties": {
        "campusId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "address": { "type": "string", "minLength": 1 },
        "timezone": { "type": "string", "minLength": 1 },
        "dataStatus": { "enum": ["pending-validation", "available", "published", "planned"] },
        "manifestPath": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "dataStatus": { "const": "available" } }, "required": ["dataStatus"] },
          "then": { "required": ["manifestPath"] }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
