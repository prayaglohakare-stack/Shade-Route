{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shaderoute:schema:campus-manifest:1",
  "title": "ShadeRoute campus bundle manifest",
  "type": "object",
  "required": ["schemaVersion", "campusId", "dataRevision", "publishedAt", "campus", "files", "sources", "limitations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "campusId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "dataRevision": { "type": "integer", "minimum": 1 },
    "publishedAt": { "type": "string", "format": "date-time" },
    "campus": { "$ref": "#/$defs/campus" },
    "files": { "$ref": "#/$defs/files" },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "coordinate": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "campus": {
      "type": "object",
      "required": ["name", "address", "timezone"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "address": { "type": "string", "minLength": 1 },
        "timezone": { "type": "string", "minLength": 1 },
        "center": { "$ref": "#/$defs/coordinate" },
        "bounds": {
          "type": "array",
          "prefixItems": [
            { "$ref": "#/$defs/coordinate" },
            { "$ref": "#/$defs/coordinate" }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "object",
      "required": ["network"],
      "properties": {
        "network": { "const": "network.json" },
        "shade": { "const": "shade.json" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["sourceId", "type", "name", "license", "attribution"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "type": { "enum": ["osm", "field-survey", "institution", "other"] },
        "name": { "type": "string", "minLength": 1 },
        "capturedAt": { "type": "string", "format": "date-time" },
        "license": { "type": "string", "minLength": 1 },
        "attribution": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
